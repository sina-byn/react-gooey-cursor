{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "react-gooey-cursor",
  "homepage": "https://react-gooey-cursor.vercel.app/",
  "items": [
    {
      "name": "gooey-cursor",
      "type": "registry:component",
      "title": "React Gooey Cursor",
      "description": "Gooey cursor component for React",
      "files": [
        {
          "type": "registry:component",
          "path": "components/gooey-cursor.tsx",
          "target": "components/gooey-cursor.tsx"
        },
        {
          "type": "registry:hook",
          "path": "hooks/use-debounce.ts",
          "target": "hooks/use-debounce.ts"
        }
      ],
      "cssVars": {
        "theme": {
          "color-cursor-background": "var(--cursor-background)",
          "animate-blob": "blob var(--animation-dur, 1.5s) ease-in forwards"
        },
        "light": {
          "cursor-background": "#ededed"
        }
      },
      "css": {
        "@layer base": {
          ".blob": {
            "scale": "var(--scale)",
            "translate": "var(--tx) var(--ty)"
          },
          ".blob.main, .blob.trail": {
            "transform": "translate(-50%, -50%)"
          }
        },
        "@keyframes blob": {
          "0%": {
            "--scale": "0.2"
          },
          "40%": {
            "--scale": "1"
          },
          "100%": {
            "--tx": "0",
            "--ty": "0"
          }
        },
        "@property --tx": {
          "syntax": "'<length>'",
          "initial-value": "0",
          "inherits": "false"
        },
        "@property --ty": {
          "syntax": "'<length>'",
          "initial-value": "0",
          "inherits": "false"
        },
        "@property --scale": {
          "syntax": "'<number>'",
          "initial-value": "1",
          "inherits": "false"
        }
      }
    }
  ]
}
